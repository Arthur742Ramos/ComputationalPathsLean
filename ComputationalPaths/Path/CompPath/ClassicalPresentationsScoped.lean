/-
# Scoped completions for classical loop presentations

This module equips the Klein-bottle and real-projective-plane expression
models with the reusable `ScopedCompletion` interface.  Their quotient
relations are generated by named normalization steps.

The resulting presentation-level objects are distinct from `PathRwQuot` formed
with the global path-rewrite relation.  They are non-collapsing computational
rewrite quotients with explicit soundness and completeness supplied by the
generic completion theorem.
-/

import ComputationalPaths.Path.CompPath.KleinBottle
import ComputationalPaths.Path.CompPath.LensSpace
import ComputationalPaths.Path.CompPath.ProjectiveSpace
import ComputationalPaths.Path.Rewrite.ScopedCompletion

namespace ComputationalPaths
namespace Path
namespace CompPath

universe u

/-! ## Klein bottle -/

abbrev KleinBottleScopedExpr : Type u :=
  KleinBottleExpr kleinBottleBase kleinBottleBase

/-- Scoped completion by semidirect-product normal form. -/
noncomputable def kleinBottleScopedCompletion :
    ScopedCompletion.Data KleinBottleScopedExpr (Int × Int) where
  encode := kleinBottleEncodeExpr'
  decode := kleinBottleDecodeExpr
  encode_decode := kleinBottleEncodeExpr_decodeExpr

abbrev KleinBottleScopedRwEq :
    KleinBottleScopedExpr → KleinBottleScopedExpr → Prop :=
  ScopedCompletion.RwEq kleinBottleScopedCompletion

theorem kleinBottleScopedRwEq_iff_encode_eq
    {p q : KleinBottleScopedExpr} :
    KleinBottleScopedRwEq p q ↔
      kleinBottleEncodeExpr' p = kleinBottleEncodeExpr' q :=
  ScopedCompletion.rweq_iff_encode_eq kleinBottleScopedCompletion

/-- Non-collapsing Klein-bottle presentation quotient. -/
abbrev KleinBottleScopedPiOne : Type u :=
  ScopedCompletion.Quotient kleinBottleScopedCompletion

/-- The scoped Klein-bottle presentation is the semidirect normal-form type. -/
noncomputable def kleinBottleScopedPiOneEquivIntProd :
    SimpleEquiv KleinBottleScopedPiOne (Int × Int) :=
  ScopedCompletion.equivNormal kleinBottleScopedCompletion

theorem kleinBottleScoped_nontrivial :
    ScopedCompletion.decodeQuot kleinBottleScopedCompletion (0, 0) ≠
      ScopedCompletion.decodeQuot kleinBottleScopedCompletion (1, 0) :=
  ScopedCompletion.decodeQuot_ne kleinBottleScopedCompletion (by decide)

/-- Concrete path certificate for Klein-bottle normalization soundness. -/
noncomputable def kleinBottleScopedNormalizationPath (p : KleinBottleScopedExpr) :
    Path
      (kleinBottleEncodeExpr' p)
      (kleinBottleEncodeExpr'
        (kleinBottleDecodeExpr (kleinBottleEncodeExpr' p))) :=
  ScopedCompletion.normalizationPath kleinBottleScopedCompletion p

noncomputable def kleinBottleScopedNormalizationCoherence
    (p : KleinBottleScopedExpr) :
    _root_.ComputationalPaths.Path.RwEq
      (Path.trans (kleinBottleScopedNormalizationPath p)
        (Path.refl
          (kleinBottleEncodeExpr'
            (kleinBottleDecodeExpr (kleinBottleEncodeExpr' p)))))
      (kleinBottleScopedNormalizationPath p) :=
  ScopedCompletion.normalizationCoherence kleinBottleScopedCompletion p

/-! ## Real projective plane -/

/-- Canonical expression for each parity class. -/
noncomputable def realProjective2ScopedDecodeExpr
    (b : RealProjectiveZ2) : RealProjective2CompPathExpr :=
  if b then RealProjective2CompPathExpr.loop
  else RealProjective2CompPathExpr.refl

@[simp] theorem realProjective2ScopedEncode_decode
    (b : RealProjectiveZ2) :
    realProjective2CompPathEncodeExpr
        (realProjective2ScopedDecodeExpr b) =
      b := by
  cases b <;> rfl

/-- Scoped completion by parity normal form. -/
noncomputable def realProjective2ScopedCompletion :
    ScopedCompletion.Data RealProjective2CompPathExpr RealProjectiveZ2 where
  encode := realProjective2CompPathEncodeExpr
  decode := realProjective2ScopedDecodeExpr
  encode_decode := realProjective2ScopedEncode_decode

abbrev RealProjective2ScopedRwEq :
    RealProjective2CompPathExpr → RealProjective2CompPathExpr → Prop :=
  ScopedCompletion.RwEq realProjective2ScopedCompletion

theorem realProjective2ScopedRwEq_iff_encode_eq
    {p q : RealProjective2CompPathExpr} :
    RealProjective2ScopedRwEq p q ↔
      realProjective2CompPathEncodeExpr p =
        realProjective2CompPathEncodeExpr q :=
  ScopedCompletion.rweq_iff_encode_eq realProjective2ScopedCompletion

/-- Non-collapsing real-projective-plane presentation quotient. -/
abbrev RealProjective2ScopedPiOne : Type u :=
  ScopedCompletion.Quotient realProjective2ScopedCompletion

/-- The scoped projective-plane presentation is equivalent to `Bool`. -/
noncomputable def realProjective2ScopedPiOneEquivZ2 :
    SimpleEquiv RealProjective2ScopedPiOne RealProjectiveZ2 :=
  ScopedCompletion.equivNormal realProjective2ScopedCompletion

theorem realProjective2Scoped_nontrivial :
    ScopedCompletion.decodeQuot realProjective2ScopedCompletion false ≠
      ScopedCompletion.decodeQuot realProjective2ScopedCompletion true :=
  ScopedCompletion.decodeQuot_ne realProjective2ScopedCompletion (by decide)

/-! ## Lens-space cyclic presentation -/

/-- Loop-power expressions for the cyclic lens-space presentation. -/
abbrev LensScopedExpr : Type := Nat

/-- Reduce a natural loop power modulo a positive `p`. -/
noncomputable def lensScopedEncode (p : Nat) (hp : 0 < p) :
    LensScopedExpr → Zp p :=
  fun n => ⟨n % p, Nat.mod_lt n hp⟩

/-- Use the canonical representative of a residue class as a loop power. -/
noncomputable def lensScopedDecode {p : Nat} : Zp p → LensScopedExpr :=
  fun x => x.val

@[simp] theorem lensScopedEncode_decode
    (p : Nat) (hp : 0 < p) (x : Zp p) :
    lensScopedEncode p hp (lensScopedDecode x) = x := by
  apply Fin.ext
  exact Nat.mod_eq_of_lt x.isLt

/-- Scoped completion for the cyclic presentation of `L(p,q)`, where `q`
does not affect the fundamental-group presentation. -/
noncomputable def lensScopedCompletion (p : Nat) (hp : 0 < p) :
    ScopedCompletion.Data LensScopedExpr (Zp p) where
  encode := lensScopedEncode p hp
  decode := lensScopedDecode
  encode_decode := lensScopedEncode_decode p hp

abbrev LensScopedRwEq (p : Nat) (hp : 0 < p) :
    LensScopedExpr → LensScopedExpr → Prop :=
  ScopedCompletion.RwEq (lensScopedCompletion p hp)

theorem lensScopedRwEq_iff_mod_eq
    (p : Nat) (hp : 0 < p) {m n : LensScopedExpr} :
    LensScopedRwEq p hp m n ↔ m % p = n % p := by
  change
    ScopedCompletion.RwEq (lensScopedCompletion p hp) m n ↔
      m % p = n % p
  rw [ScopedCompletion.rweq_iff_encode_eq]
  constructor
  · intro h
    simpa [lensScopedCompletion, lensScopedEncode] using
      _root_.congrArg Fin.val h
  · intro h
    apply Fin.ext
    simpa [lensScopedCompletion, lensScopedEncode] using h

/-- Non-collapsing cyclic lens-space presentation quotient. -/
abbrev LensScopedPiOne (p : Nat) (hp : 0 < p) : Type :=
  ScopedCompletion.Quotient (lensScopedCompletion p hp)

/-- The scoped lens presentation is equivalent to `Fin p`. -/
noncomputable def lensScopedPiOneEquivZp (p : Nat) (hp : 0 < p) :
    SimpleEquiv (LensScopedPiOne p hp) (Zp p) :=
  ScopedCompletion.equivNormal (lensScopedCompletion p hp)

theorem lensScopedTwo_nontrivial :
    ScopedCompletion.decodeQuot (lensScopedCompletion 2 (by decide))
        (⟨0, by decide⟩ : Zp 2) ≠
      ScopedCompletion.decodeQuot (lensScopedCompletion 2 (by decide))
        (⟨1, by decide⟩ : Zp 2) :=
  ScopedCompletion.decodeQuot_ne (lensScopedCompletion 2 (by decide)) (by decide)

end CompPath
end Path
end ComputationalPaths
